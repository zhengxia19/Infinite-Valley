{
  "name": "infinite-valley",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "node --experimental-strip-types --test tests/world.test.ts tests/asset-review.test.mjs",
    "assets:review": "node tools/art/approved_components_v1/build.mjs",
    "predev": "npm run assets:review",
    "prebuild": "npm run assets:review"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "^8.0.8"
  }
}
